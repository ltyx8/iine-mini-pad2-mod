# 统一换行符，避免 Windows / Linux 交叉修改时整文件被标记为改动
* text=auto

# 这两个文件本身必须保持 LF，否则规则会被自己改写
.gitattributes text eol=lf
.gitignore text eol=lf

# cmd.exe 只认 CRLF，务必固定
*.cmd text eol=crlf
*.bat text eol=crlf
*.ps1 text eol=crlf
*.txt text eol=crlf

# 源码与网页用 LF
*.py text eol=lf
*.html text eol=lf
*.md text eol=lf
*.json text eol=lf

# 二进制，不做任何转换
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.exe binary
*.zip binary
*.jar binary
*.apk binary
